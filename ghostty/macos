# macOS-only Ghostty keys.
# setup.sh and update.sh link this to
# ~/Library/Application Support/com.mitchellh.ghostty/config
# Ghostty loads that path only on macOS, after ~/.config/ghostty/config.
# Linux therefore keeps the Catppuccin Mocha theme without cmd chords.

macos-titlebar-style = transparent
background-blur = 20

keybind = global:ctrl+grave_accent=toggle_quick_terminal
keybind = cmd+shift+enter=new_split:right
keybind = cmd+opt+enter=new_split:down
keybind = cmd+d=close_surface
keybind = cmd+alt+left=goto_split:left
keybind = cmd+alt+right=goto_split:right
keybind = cmd+alt+up=goto_split:top
keybind = cmd+alt+down=goto_split:bottom
keybind = cmd+shift+e=equalize_splits
keybind = cmd+shift+f=toggle_split_zoom
keybind = cmd+shift+comma=reload_config
