# Work-machine tools. Not loaded on every login.
# Opt in from the gitignored host file ~/.config/zsh/hosts:
#   export DOTS_LOAD_WORK=1
# shellcheck disable=SC2139  # intentional expansion at definition time
export GAMCFGDIR="$HOME/Developer/GAM/GAMConfig"
alias gam="$HOME/bin/gam7/gam"
alias gam7="$HOME/bin/gam7/gam"
alias gws="$HOME/bin/gam7/gam"

# Tailscale Jamf Checker
if [[ -d ~/Developer/tailscale-jamf-checker ]]; then
  tc() { (cd ~/Developer/tailscale-jamf-checker && npm run check -- --serial "$1"); }
fi
