# .zshenv - Sourced for all zsh sessions (interactive, non-interactive, login, non-login)
# This file is loaded before .zshrc
# All PATH modifications should be centralized here

# Function to add directories to PATH without duplicates
add_to_path() {
    if [[ -d "$1" ]] && [[ ":$PATH:" != *":$1:"* ]]; then
        export PATH="$1:$PATH"
    fi
}

# Homebrew (required early for non-interactive shells like mosh-server)
# Darwin: Apple Silicon, then Intel, via brew shellenv (PATH, MANPATH, HOMEBREW_*).
# Linuxbrew is not initialized unless this machine opted in with ./setup.sh --brew
# (marker ~/.config/zsh/use-brew, or DOTS_USE_BREW=1).
if [[ "$(uname)" == "Darwin" ]]; then
    if [[ -x /opt/homebrew/bin/brew ]]; then
        if ! eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null)"; then
            echo "Warning: Failed to initialize Homebrew" >&2
        fi
    elif [[ -x /usr/local/bin/brew ]]; then
        if ! eval "$(/usr/local/bin/brew shellenv 2>/dev/null)"; then
            echo "Warning: Failed to initialize Homebrew (Intel)" >&2
        fi
    else
        add_to_path "/opt/homebrew/bin"
        add_to_path "/opt/homebrew/sbin"
        add_to_path "/usr/local/bin"
    fi
else
    if [[ -d "/usr/local/bin" ]]; then
        add_to_path "/usr/local/bin"
    fi
    if [[ "$(uname)" == "Linux" ]]; then
        if [[ "${DOTS_USE_BREW:-0}" == "1" || -f "${HOME}/.config/zsh/use-brew" ]]; then
            if [[ -x "${HOME}/.linuxbrew/bin/brew" ]]; then
                if ! eval "$("${HOME}/.linuxbrew/bin/brew" shellenv 2>/dev/null)"; then
                    echo "Warning: Failed to initialize Linuxbrew" >&2
                fi
            elif [[ -x /home/linuxbrew/.linuxbrew/bin/brew ]]; then
                if ! eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv 2>/dev/null)"; then
                    echo "Warning: Failed to initialize Linuxbrew" >&2
                fi
            fi
        fi
    fi
fi

# Local bin directories
add_to_path "$HOME/.local/bin"
add_to_path "$HOME/bin"

# Development tool paths (will be properly initialized in zshrc)
# pyenv
if [[ -d "$HOME/.pyenv/bin" ]]; then
    export PYENV_ROOT="$HOME/.pyenv"
    add_to_path "$PYENV_ROOT/bin"
fi

# Cargo (Rust)
if [[ -d "$HOME/.cargo/bin" ]]; then
    add_to_path "$HOME/.cargo/bin"
fi

# Go
if [[ -d "$HOME/.local/opt/go/bin" ]]; then
    add_to_path "$HOME/.local/opt/go/bin"
fi
if [[ -d "$HOME/go/bin" ]]; then
    add_to_path "$HOME/go/bin"
fi

# Ruby gems
if [[ -d "$HOME/.gem/ruby" ]]; then
    # Find the latest Ruby version directory (only match valid version patterns)
    latest_ruby=$(find "$HOME/.gem/ruby" -maxdepth 1 -type d -name "[0-9]*.[0-9]*" 2>/dev/null | sort -V | tail -1)
    if [[ -n "$latest_ruby" ]]; then
        add_to_path "$latest_ruby/bin"
    fi
fi

# Bun
if [[ -d "$HOME/.bun/bin" ]]; then
    export BUN_INSTALL="$HOME/.bun"
    add_to_path "$BUN_INSTALL/bin"
fi

# Zoxide for non-interactive shells (Claude Code, mosh, zsh -c)
# Interactive shells get zoxide with --cmd cd from .zshrc instead
if command -v zoxide &>/dev/null && [[ ! -o interactive ]]; then
    eval "$(zoxide init zsh)"
fi
