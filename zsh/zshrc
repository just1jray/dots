### Added by Zinit's installer
if [[ ! -f $HOME/.local/share/zinit/zinit.git/zinit.zsh ]]; then
    print -P "%F{33} %F{220}Installing %F{33}ZDHARMA-CONTINUUM%F{220} Initiative Plugin Manager (%F{33}zdharma-continuum/zinit%F{220})…%f"
    command mkdir -p "$HOME/.local/share/zinit" && command chmod g-rwX "$HOME/.local/share/zinit"
    # Shallow clone: first launch does not need full history.
    command git clone --depth=1 https://github.com/zdharma-continuum/zinit "$HOME/.local/share/zinit/zinit.git" && \
        print -P "%F{33} %F{34}Installation successful.%f%b" || \
        print -P "%F{160} The clone has failed.%f%b"
fi

source "$HOME/.local/share/zinit/zinit.git/zinit.zsh"
autoload -Uz _zinit
# shellcheck disable=SC2154  # _comps is a zsh completion array
(( ${+_comps} )) && _comps[zinit]=_zinit
### End of Zinit's installer chunk

# Environment Setup
# LANG and PATH are managed in .zshenv
EDITOR=$(command -v nvim >/dev/null && echo "nvim" || echo "vim")
export EDITOR
[[ $EDITOR == "nvim" ]] && alias vim="nvim"
command -v codium &> /dev/null && alias code="codium"

# Set LS_COLORS for file type coloring
if command -v vivid &> /dev/null; then
    LS_COLORS="$(vivid generate catppuccin-mocha)"
    export LS_COLORS
fi

# Load Custom Aliases
if [[ -f "$HOME/.config/zsh/aliases" ]]; then
    source "$HOME/.config/zsh/aliases"
else
    echo "Warning: ~/.config/zsh/aliases not found; skipping custom aliases." >&2
fi

# Allow aliases to work with sudo
alias sudo='sudo '

# Vi mode
bindkey -v
export KEYTIMEOUT=20  # Allow double-Esc bindings (200ms)

# Keybindings (set after vi mode to override defaults)
bindkey '^p' history-search-backward
bindkey '^n' history-search-forward
bindkey '^\[w' kill-region
bindkey -M viins '^@' set-mark-command  # Ctrl-Space

# vv in normal mode edits the command line in $EDITOR (single v stays visual mode)
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd 'vv' edit-command-line

# History Configuration
HISTSIZE=50000                      # Increased from 5000 for better history retention
HISTFILE=~/.zsh_history
# shellcheck disable=SC2034  # SAVEHIST is used by zsh
SAVEHIST=$HISTSIZE
setopt appendhistory                # Append to history file, don't overwrite
setopt sharehistory                 # Share history between all sessions
setopt extended_history             # Record timestamp of command in HISTFILE
setopt hist_ignore_space            # Ignore commands that start with space
setopt hist_ignore_all_dups         # Delete old recorded entry if new entry is a duplicate
setopt hist_save_no_dups            # Don't write duplicate entries in the history file
setopt hist_find_no_dups            # Don't display a line previously found
setopt hist_reduce_blanks           # Remove superfluous blanks before recording entry
setopt hist_verify                  # Don't execute immediately upon history expansion
setopt auto_cd                      # Auto cd to a directory without typing cd

# Completion styling
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Za-z}'
# shellcheck disable=SC2296  # zsh parameter expansion syntax
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# Load Custom Host Configurations
# shellcheck disable=SC2139  # intentional expansion at definition time
[[ -f "$HOME/.config/zsh/hosts" ]] && source "$HOME/.config/zsh/hosts" && alias hosts="cat $HOME/.config/zsh/hosts"

# Platform-specific configurations
if [[ "$OSTYPE" == darwin* ]]; then
    [[ -f "$HOME/.config/zsh/profile-macos" ]] && source "$HOME/.config/zsh/profile-macos"
elif [[ "$OSTYPE" == linux* ]]; then
    [[ -f "$HOME/.config/zsh/profile-linux" ]] && source "$HOME/.config/zsh/profile-linux"
fi

# Docker CLI completions (fpath must be set before compinit)
# Note: Docker Desktop may re-add compinit lines at end of file - remove them if so
# shellcheck disable=SC2206  # zsh array assignment syntax
[[ -d "$HOME/.docker/completions" ]] && fpath=("$HOME/.docker/completions" $fpath)

# Completion system. fzf-tab needs compinit first and must load before
# widget-wrapping plugins (fast-syntax-highlighting, autosuggestions).
zicompinit
zicdreplay

# fzf
# LS_PREVIEW comes from aliases. Fallback must not pass GNU-only flags on Darwin.
if [[ -z "${LS_PREVIEW-}" ]]; then
    if [[ "$OSTYPE" == darwin* ]]; then
        LS_PREVIEW="CLICOLOR_FORCE=1 ls -G"
    else
        LS_PREVIEW="ls --color"
    fi
fi
if command -v eza &> /dev/null; then
    FZF_DIR_PREVIEW="eza -1 --color=always --icons=always"
else
    FZF_DIR_PREVIEW="$LS_PREVIEW"
fi

# Catppuccin Mocha theme for fzf and fzf-tab
# shellcheck disable=SC2054  # commas belong to fzf --color values
FZF_MOCHA_COLORS=(
    --color=bg+:#313244,bg:#1e1e2e,spinner:#f5e0dc,hl:#f38ba8
    --color=fg:#cdd6f4,header:#f38ba8,info:#cba6f7,pointer:#f5e0dc
    --color=marker:#f5e0dc,fg+:#cdd6f4,prompt:#cba6f7,hl+:#f38ba8
)

if command -v fzf &> /dev/null; then
    export FZF_DEFAULT_OPTS="--height=80% ${FZF_MOCHA_COLORS[*]}"

    # fzf < 0.48 (e.g. Ubuntu 24.04 apt) has no --zsh and prints nothing
    _fzf_init="$(fzf --zsh 2>/dev/null)"
    if [[ -n "$_fzf_init" ]]; then
        eval "$_fzf_init"
    elif [[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ]]; then
        source /usr/share/doc/fzf/examples/key-bindings.zsh
        [[ -f /usr/share/doc/fzf/examples/completion.zsh ]] && source /usr/share/doc/fzf/examples/completion.zsh
    else
        echo "Warning: Failed to initialize fzf" >&2
    fi
    unset _fzf_init

    zinit light Aloxaf/fzf-tab

    zstyle ':completion:*' menu no
    zstyle ':fzf-tab:*' fzf-flags --height=80% "${FZF_MOCHA_COLORS[@]}"
    # shellcheck disable=SC2016  # $realpath is expanded later by fzf-tab
    zstyle ':fzf-tab:complete:cd:*' fzf-preview "${FZF_DIR_PREVIEW} \$realpath"
else
    zstyle ':completion:*' menu select
fi

# ZSH Plugins
# Load fast-syntax-highlighting synchronously to avoid prompt issues
zinit light zdharma-continuum/fast-syntax-highlighting

# Load other plugins with turbo mode for faster startup
zinit wait lucid light-mode for \
    atload"_zsh_autosuggest_start" \
        zsh-users/zsh-autosuggestions \
    blockf atpull'zinit creinstall -q .' \
        zsh-users/zsh-completions

# zoxide (interactive only; guard against re-sourcing .zshrc)
if command -v zoxide &> /dev/null && ! typeset -f __zoxide_z &> /dev/null; then
    if ! eval "$(zoxide init --cmd cd zsh 2>/dev/null)"; then
        echo "Warning: Failed to initialize zoxide" >&2
    else
        # shellcheck disable=SC2016  # $realpath is expanded later by fzf-tab
        zstyle ':fzf-tab:complete:__zoxide_z:*' fzf-preview "${FZF_DIR_PREVIEW} \$realpath"
    fi
fi

# Add in snippets
zinit snippet OMZP::sudo
zinit snippet OMZP::command-not-found

# Work tools are not on every machine. Opt in from the gitignored host file
# (~/.config/zsh/hosts) or the environment: export DOTS_LOAD_WORK=1
if [[ "${DOTS_LOAD_WORK:-0}" == "1" && -f "$HOME/.config/zsh/profile-work" ]]; then
    # shellcheck source=profile-work
    source "$HOME/.config/zsh/profile-work"
fi

# Development Environment Managers
# Note: PYENV_ROOT and PATH are set in .zshenv
if command -v pyenv &> /dev/null; then
    # Initialize pyenv with error handling
    # --no-rehash: rehashing every shell costs ~80ms; pyenv rehashes on install
    if ! eval "$(pyenv init - --no-rehash zsh 2>/dev/null)"; then
        echo "Warning: Failed to initialize pyenv" >&2
    fi
fi

# NVM lazy-loading: Unlike fzf/zoxide/pyenv which use eval-on-check,
# NVM is loaded via wrapper functions because it adds 300-800ms to startup.
# This pattern defers loading until first use of node/npm/nvm commands.
export NVM_DIR="$HOME/.nvm"

if [[ -s "$NVM_DIR/nvm.sh" ]]; then
    _nvm_loaded=false

    _load_nvm() {
        [[ "$_nvm_loaded" == true ]] && return
        _nvm_loaded=true
        unset -f nvm node npm npx 2>/dev/null
        source "$NVM_DIR/nvm.sh"
        [[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
    }

    # Wrapper functions trigger lazy load on first use. When .zshenv already
    # put the default node on PATH, node/npm/npx run it directly.
    nvm() { _load_nvm; nvm "$@"; }
    # shellcheck disable=SC2154  # path is the zsh array tied to PATH
    if [[ "${path[*]}" != *"$NVM_DIR/versions/node/"* ]]; then
        node() { _load_nvm; node "$@"; }
        npm() { _load_nvm; npm "$@"; }
        npx() { _load_nvm; npx "$@"; }
    fi
fi

# Bun completions
# Note: BUN_INSTALL and PATH are set in .zshenv
[[ -s "$HOME/.bun/_bun" ]] && source "$HOME/.bun/_bun"

# TMUX Session Management
# No auto-start: launch tmux explicitly with `t` or `sesh` (see zsh/aliases).

# Disable paste highlighting for cleaner pasting
# shellcheck disable=SC2034  # zle_highlight is used by zsh
zle_highlight=('paste:none')

# Catppuccin Mocha on every OS. Linux must not unset STARSHIP_CONFIG.
export STARSHIP_CONFIG="${STARSHIP_CONFIG:-$HOME/.config/starship.toml}"

# Initialize Starship prompt (guard against re-initialization to prevent
# zle-keymap-select wrapper recursion when sourcing .zshrc multiple times)
if command -v starship &> /dev/null && ! typeset -f starship_zle-keymap-select > /dev/null; then
    if ! eval "$(starship init zsh 2>/dev/null)"; then
        echo "Warning: Failed to initialize Starship prompt" >&2
    fi
fi

# 1Password CLI shell plugins
[[ -f "$HOME/.config/op/plugins.sh" ]] && source "$HOME/.config/op/plugins.sh"
