# Device inventory for the homelab skills.
#
# Copy to ~/.config/homelab/devices.env, fill in real values, and chmod 600.
# The real file is intentionally not tracked.
#
#   mkdir -p ~/.config/homelab
#   cp llm/devices.env.template ~/.config/homelab/devices.env
#   chmod 600 ~/.config/homelab/devices.env
#
# Used by: llm/skills/debugging-xgimi-projector, llm/skills/managing-asus-router

# --- Android TV projector (ADB over wifi) ---
PROJECTOR_HOST=
PROJECTOR_ADB=          # HOST:5555
PROJECTOR_MAC=
PROJECTOR_NAME=
PROJECTOR_REMOTE_BT_MAC=
PROJECTOR_WORKDIR="$HOME/Developer/xgimi-debloat"

# --- Router (SSH) ---
ROUTER_HOST=
ROUTER_USER=
ROUTER_KEY="$HOME/.ssh/id_router"
ROUTER_MODEL=
LAN_PREFIX=             # e.g. 192.168.1

ROUTER_SSH_OPTS="-o IdentitiesOnly=yes -o ConnectTimeout=8"
