# Git Configuration
# User settings should be configured locally per machine in ~/.gitconfig.local:
# git config --file ~/.gitconfig.local user.name "Your Name"
# git config --file ~/.gitconfig.local user.email "your.email@example.com"

[user]
    # Refuse to guess identity if ~/.gitconfig.local is missing
    useConfigOnly = true

[core]
    excludesfile = ~/.gitignore_global
    autocrlf = input
    # Improve performance for large repositories
    preloadindex = true

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true
    followTags = true

[fetch]
    prune = true

[column]
    ui = auto

[branch]
    sort = -committerdate

[tag]
    sort = version:refname

[commit]
    verbose = true

[color]
    ui = auto
    branch = auto
    diff = auto
    status = auto

[color "branch"]
    current = yellow reverse
    local = yellow
    remote = green

[color "diff"]
    meta = yellow bold
    frag = magenta bold
    old = red bold
    new = green bold

[color "status"]
    added = green
    changed = yellow
    untracked = cyan

[diff]
    algorithm = histogram
    colorMoved = zebra

[merge]
    # Show common ancestor in merge conflicts
    conflictstyle = zdiff3
    autoStash = true

[rebase]
    autoStash = true
    autoSquash = true
    updateRefs = true

[rerere]
    enabled = true
    autoUpdate = true

[delta]
    navigate = true
    features = catppuccin-mocha

[alias]
    st = status -sb
    co = checkout
    cob = checkout -b
    br = branch
    ci = commit
    cm = commit -m
    df = diff
    dfc = diff --cached
    lg = log --oneline --graph --decorate
    last = log -1 HEAD --stat

[help]
    autocorrect = prompt

[credential]
    helper = cache --timeout=3600

# Catppuccin theme for delta
[include]
    path = ~/.config/delta/catppuccin.gitconfig

# Machine-specific settings (identity, credentials); included last so it wins
[include]
    path = ~/.gitconfig.local
