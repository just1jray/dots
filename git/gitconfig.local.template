# Local Git Configuration Template
# Copy this to ~/.gitconfig.local and customize with your personal settings
# The main gitconfig will automatically include this file

[user]
    name = Your Name
    email = your.email@example.com
    # Uncomment and set if using GPG signing
    # signingkey = YOUR_GPG_KEY_ID

# Uncomment to enable commit signing
# [commit]
#     gpgsign = true

# Credential helpers: the empty "helper =" line clears the global cache helper
# Recommended (any platform): run `gh auth setup-git` to use the GitHub CLI

# macOS-specific credential helper
# [credential]
#     helper =
#     helper = osxkeychain

# Linux-specific credential helper (Debian/Ubuntu)
# Build first: sudo make -C /usr/share/doc/git/contrib/credential/libsecret
# [credential]
#     helper =
#     helper = /usr/share/doc/git/contrib/credential/libsecret/git-credential-libsecret

# Work identity for repos under ~/Developer/work/
# [includeIf "gitdir:~/Developer/work/"]
#     path = ~/.gitconfig.work
